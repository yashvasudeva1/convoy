DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transitops?schema=public"
# Or point at a hosted Postgres (e.g. Supabase connection string) — see team channel for the shared demo DB URL.
# If using Supabase's session-mode pooler (port 5432), it caps concurrent connections (often 15 on the free tier)
# across ALL teammates combined. Add &connection_limit=3&pool_timeout=10 to the URL so one backend instance
# can't exhaust the shared pool on its own — otherwise you'll see "max clients reached in session mode" 500s.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
