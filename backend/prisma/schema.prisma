generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum MaintenanceStatus {
  OPEN
  CLOSED
}

enum TripStatus {
  PENDING
  DISPATCHED
  COMPLETED
  CANCELLED
}

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id                 String            @id @default(uuid())
  registrationNumber String            @unique
  make               String
  model              String
  type               String            @default("Van")
  capacityKg         Float
  odometerKm         Float             @default(0)
  acquisitionCost    Float             @default(0)
  region             String?
  status             VehicleStatus     @default(AVAILABLE)
  maintenanceLogs    MaintenanceLog[]
  trips              Trip[]
  fuelLogs            FuelLog[]
  expenseLogs         ExpenseLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Driver {
  id             String       @id @default(uuid())
  name           String
  licenseNumber  String       @unique
  licenseCategory String      @default("LMV")
  licenseExpiry  DateTime
  contactNumber  String       @default("")
  safetyScore    Int          @default(100)
  status         DriverStatus @default(AVAILABLE)
  trips          Trip[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MaintenanceLog {
  id          String            @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  reason      String
  notes       String?
  cost        Float             @default(0)
  status      MaintenanceStatus @default(OPEN)
  openedAt    DateTime          @default(now())
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Trip {
  id                  String     @id @default(uuid())
  vehicleId           String
  driverId            String
  vehicle             Vehicle    @relation(fields: [vehicleId], references: [id])
  driver              Driver     @relation(fields: [driverId], references: [id])
  origin              String
  destination         String
  cargoWeightKg       Float
  plannedDistanceKm   Float      @default(0)
  finalOdometerKm     Float?
  fuelConsumedLiters  Float?
  revenue             Float      @default(0)
  status              TripStatus @default(PENDING)
  createdAt           DateTime   @default(now())
  dispatchedAt        DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  fuelLogs      FuelLog[]
  expenseLogs   ExpenseLog[]
}

model FuelLog {
  id         String   @id @default(uuid())
  tripId     String?
  vehicleId  String
  trip       Trip?    @relation(fields: [tripId], references: [id])
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  liters     Float
  cost       Float
  odometer   Float?
  loggedAt   DateTime @default(now())
}

model ExpenseLog {
  id          String   @id @default(uuid())
  tripId      String?
  vehicleId   String
  trip        Trip?    @relation(fields: [tripId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  category    String
  amount      Float
  description String?
  loggedAt    DateTime @default(now())
}
